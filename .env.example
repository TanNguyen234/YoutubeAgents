# ==============================================================================
# YouTube Autopilot — Environment Configuration Template
# Copy this file to .env and populate with actual credentials when needed.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# Runtime Environment Mode: DRY_RUN | DEVELOPMENT | PRODUCTION
APP_ENV=DRY_RUN

# Log Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Database Configuration (Default: local SQLite)
DATABASE_URL=sqlite:///data/youtube_autopilot.db

# Output & Storage Directories
OUTPUT_DIR=output
DATA_DIR=data

# YouTube API Configuration (OAuth 2.0 / API Keys)
# Required only for YouTube Upload/Schedule and Analytics operations
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secret.json
YOUTUBE_OAUTH_TOKEN_FILE=config/oauth_token.json

# Default Upload Privacy Status: private (MANDATORY default; public requires human review)
YOUTUBE_DEFAULT_PRIVACY_STATUS=private

# FFmpeg Executable Path (if not on system PATH)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
