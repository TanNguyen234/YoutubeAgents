# .gitignore for YouTube Autopilot

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Google / YouTube credentials
client_secret*.json
config/client_secret*.json
oauth_token*.json
config/oauth_token*.json
credentials.json
config/credentials.json
oauth_credentials.json

# Databases & Local Storage
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# Output, Media, Scratch & Reference Artefacts
output/*
!output/.gitkeep
data/raw/*
data/temp/*
data/cache/*
data/evidence/*
!data/.gitkeep
references/*
!references/.gitkeep

# Testing & Linting Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
